<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= product.name %> - Sport Store</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

    <%- include('partials/store_header') %>

    <div class="container" style="padding-top: 2rem;">
        <a href="/" style="font-weight: 600; font-size: 0.9rem; margin-bottom: 2rem; display: inline-block;">&larr; Quay lại mua sắm</a>
        
        <div class="product-detail-wrapper">
            <div class="product-image-large">
                <img src="<%= product.image %>" alt="<%= product.name %>">
            </div>
            
            <div class="product-info-large">
                <div class="brand"><%= product.brand %> &bull; <%= product.category %></div>
                <h1><%= product.name %></h1>
                <div class="price"><%= product.price.toLocaleString('vi-VN') %>₫</div>
                
                <div class="desc">
                    <%= product.description || 'Chưa có mô tả chi tiết cho sản phẩm này.' %>
                </div>
                
                <form action="/cart/add/<%= product._id %>" method="POST" style="margin-top: 2rem;">
                    <button type="submit" class="btn-large">THÊM VÀO GIỎ HÀNG</button>
                </form>
            </div>
        </div>
    </div>

    <%- include('partials/store_footer') %>

</body>
</html>
