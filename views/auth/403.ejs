<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>403 — Không có quyền truy cập | SportShop</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/auth.css">
</head>
<body class="auth-body">
    <div class="error-page">
        <div class="error-content">
            <div class="error-code">403</div>
            <h1 class="error-title">Không có quyền truy cập</h1>
            <p class="error-desc">
                Tài khoản <strong><%= user ? user.email : 'của bạn' %></strong>
                <% if (user) { %>
                    (role: <span class="role-badge role-<%= user.role %>"><%= user.role.toUpperCase() %></span>)
                <% } %>
                không có quyền truy cập trang này.
            </p>
            <div class="error-actions">
                <a href="/" class="auth-btn" style="display:inline-flex; width:auto; padding: 0.9rem 2rem;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
                    Về trang chủ
                </a>
                <form action="/logout" method="POST" style="display:inline;">
                    <button type="submit" class="auth-btn auth-btn-outline" style="display:inline-flex; width:auto; padding: 0.9rem 2rem;">
                        Đăng xuất
                    </button>
                </form>
            </div>
        </div>
    </div>
</body>
</html>
