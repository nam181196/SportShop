<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Đăng Nhập — SportShop</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/auth.css">
</head>
<body class="auth-body">

    <div class="auth-container">
        <!-- Left Panel -->
        <div class="auth-brand-panel">
            <a href="/" class="auth-logo">SPORTSHOP.</a>
            <div class="auth-brand-content">
                <h2>Chào mừng trở lại</h2>
                <p>Đăng nhập để trải nghiệm mua sắm thể thao đỉnh cao.</p>
            </div>
        </div>

        <!-- Right Panel -->
        <div class="auth-form-panel">
            <div class="auth-form-wrapper">
                <h1 class="auth-title">Đăng nhập</h1>
                <p class="auth-subtitle">Chưa có tài khoản? <a href="/register">Đăng ký ngay</a></p>

                <% if (typeof error !== 'undefined' && error) { %>
                    <div class="auth-alert auth-alert-error">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                        <%= error %>
                    </div>
                <% } %>

                <form action="/login" method="POST" class="auth-form" id="login-form">
                    <div class="form-group">
                        <label for="email">Email</label>
                        <input
                            type="email"
                            id="email"
                            name="email"
                            class="form-control"
                            placeholder="example@email.com"
                            value="<%= typeof formData !== 'undefined' ? formData.email : '' %>"
                            required
                            autocomplete="email"
                        >
                    </div>

                    <div class="form-group">
                        <label for="password">
                            Mật khẩu
                            <a href="#" class="forgot-link">Quên mật khẩu?</a>
                        </label>
                        <div class="password-wrapper">
                            <input
                                type="password"
                                id="password"
                                name="password"
                                class="form-control"
                                placeholder="••••••••"
                                required
                                autocomplete="current-password"
                            >
                            <button type="button" class="toggle-password" onclick="togglePassword('password')" aria-label="Hiện mật khẩu">
                                <svg id="eye-icon-password" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                            </button>
                        </div>
                    </div>

                    <button type="submit" class="auth-btn" id="login-btn">
                        <span>Đăng nhập</span>
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                    </button>
                </form>

                <!-- Quick login hints for testing -->
                <div class="quick-login">
                    <p class="quick-login-title">Tài khoản test nhanh:</p>
                    <div class="quick-login-btns">
                        <button type="button" class="quick-btn admin-quick" onclick="fillLogin('admin@sportshop.vn','Admin@123')">
                            🔑 Admin
                        </button>
                        <button type="button" class="quick-btn user-quick" onclick="fillLogin('user1@gmail.com','User@123')">
                            👤 User
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        function togglePassword(id) {
            const input = document.getElementById(id);
            input.type = input.type === 'password' ? 'text' : 'password';
        }
        function fillLogin(email, password) {
            document.getElementById('email').value = email;
            document.getElementById('password').value = password;
        }
    </script>
</body>
</html>
