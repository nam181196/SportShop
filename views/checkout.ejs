<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Thanh Toán - Sport Store</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .checkout-layout { display: grid; grid-template-columns: 3fr 2fr; gap: 4rem; margin-top: 2rem; align-items: start; }
        .checkout-form { background: var(--white); padding: 3rem; border-radius: 16px; box-shadow: var(--shadow-sm); }
        .checkout-form h3 { margin-bottom: 2rem; font-size: 1.5rem; }
        .row { display: flex; gap: 1.5rem; margin-bottom: 1.5rem; }
        .col { flex: 1; }
        .form-group label { display: block; margin-bottom: 0.5rem; font-weight: 600; font-size: 0.9rem; color: var(--text-secondary); }
        .form-control { width: 100%; padding: 0.8rem 1rem; border: 1px solid var(--border-color); border-radius: 8px; font-size: 1rem; font-family: inherit; }
        .form-control:focus { outline: none; border-color: var(--text-primary); }
    </style>
</head>
<body>

    <%- include('partials/store_header') %>

    <div class="container">
        <h2 class="section-title" style="text-align: left; margin-bottom: 2rem;">Thanh Toán</h2>
        
        <div class="checkout-layout">
            <div class="checkout-form">
                <h3>Thông Tin Giao Hàng</h3>
                <form action="/checkout" method="POST">
                    <div class="row">
                        <div class="col form-group">
                            <label>Họ và Tên</label>
                            <input type="text" class="form-control" required placeholder="Nhập họ và tên">
                        </div>
                        <div class="col form-group">
                            <label>Số Điện Thoại</label>
                            <input type="text" class="form-control" required placeholder="Nhập số điện thoại">
                        </div>
                    </div>
                    
                    <div class="form-group" style="margin-bottom: 1.5rem;">
                        <label>Email</label>
                        <input type="email" class="form-control" required placeholder="Nhập địa chỉ email">
                    </div>
                    
                    <div class="form-group" style="margin-bottom: 1.5rem;">
                        <label>Địa Chỉ Giao Hàng</label>
                        <input type="text" class="form-control" required placeholder="Nhập địa chỉ chi tiết">
                    </div>
                    
                    <div class="form-group" style="margin-bottom: 3rem;">
                        <label>Ghi Chú Đơn Hàng (Tùy chọn)</label>
                        <textarea class="form-control" rows="3" placeholder="Ghi chú về giao hàng..."></textarea>
                    </div>
                    
                    <h3>Phương Thức Thanh Toán</h3>
                    <div class="form-group" style="margin-bottom: 2rem; border: 1px solid var(--border-color); padding: 1.5rem; border-radius: 8px;">
                        <div style="display: flex; align-items: center; gap: 10px;">
                            <input type="radio" name="payment" id="cod" checked>
                            <label for="cod" style="margin: 0; font-size: 1.1rem; color: var(--text-primary);">Thanh toán khi nhận hàng (COD)</label>
                        </div>
                    </div>
                    
                    <button type="submit" class="btn-large">ĐẶT HÀNG NGAY</button>
                </form>
            </div>
            
            <div class="cart-summary" style="top: 120px;">
                <h3 style="margin-bottom: 1.5rem; font-size: 1.5rem;">Đơn Hàng Của Bạn</h3>
                
                <div style="margin-bottom: 2rem; border-bottom: 1px solid var(--border-color); padding-bottom: 1.5rem;">
                    <% cart.forEach(item => { %>
                        <div style="display: flex; justify-content: space-between; margin-bottom: 1rem; align-items: center;">
                            <div style="display: flex; gap: 15px; align-items: center;">
                                <img src="<%= item.product.image %>" alt="<%= item.product.name %>" style="width: 60px; height: 60px; object-fit: cover; border-radius: 8px;">
                                <div>
                                    <div style="font-weight: 600;"><%= item.product.name %></div>
                                    <div style="font-size: 0.85rem; color: var(--text-secondary);">SL: <%= item.quantity %></div>
                                </div>
                            </div>
                            <div style="font-weight: 600;"><%= (item.product.price * item.quantity).toLocaleString('vi-VN') %>₫</div>
                        </div>
                    <% }) %>
                </div>
                
                <div class="summary-row">
                    <span>Tạm tính</span>
                    <strong><%= total.toLocaleString('vi-VN') %>₫</strong>
                </div>
                <div class="summary-row">
                    <span>Phí giao hàng</span>
                    <strong>Miễn phí</strong>
                </div>
                
                <div class="summary-row summary-total">
                    <span>Tổng Cộng</span>
                    <span><%= total.toLocaleString('vi-VN') %>₫</span>
                </div>
            </div>
        </div>
    </div>

    <%- include('partials/store_footer') %>

</body>
</html>
